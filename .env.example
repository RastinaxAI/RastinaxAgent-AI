# Never commit live credentials. This file contains placeholders only.
AI_ENVIRONMENT=development
AI_SERVICE_TOKEN=
AI_ALLOW_ANONYMOUS_DEV=false

# Provider selections: kilo, groq, openrouter, ollama, custom / none for fallback
AI_PRIMARY_PROVIDER=kilo
AI_FALLBACK_PROVIDER=none

# Candidate with historical direct Iran access evidence; retest on production server.
KILO_BASE_URL=https://ai-gateway.kilo.ai/api/v1
KILO_MODEL=kilo-auto/free
KILO_API_KEY=

# Groq may be geo-blocked in Iran; use only after a successful target-server probe.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Strictly free router only by default; no automatic paid model selection
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
AI_ALLOW_PAID_OPENROUTER=false

# Optional local fallback. Run Ollama yourself and pull the model first.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# Any OpenAI-compatible provider, including permitted domestic deployments
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=
AI_ALLOW_PRIVATE_HTTP=false

AI_REQUEST_TIMEOUT_SECONDS=35
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_TOOL_ROUNDS=2
AI_MAX_HISTORY_MESSAGES=16
AI_MAX_HISTORY_CHARS=16000
AI_MAX_CONCURRENT_REQUESTS=16
